{
  "manifest_version": 3,
  "name": "FoxHome",
  "version": "1.0.6",
  "description": "把新标签页和主页变成自己的起始页：搜索框、常用快捷方式（按浏览历史自动补充）、最近浏览卡片。数据只在你的电脑上流转，不发送到任何服务器。",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxhome@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "history"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "chrome_settings_overrides": {
    "homepage": "index.html"
  }
}
